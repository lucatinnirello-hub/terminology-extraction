    {
      "parameters": {
        "jsCode": "// Marks the failed job's row in the log sheet, matched by the n8n\n// execution ID recorded when the job was accepted. Several jobs can run at\n// once, so the execution ID (not the status) identifies the right row.\n// Errors before a job was accepted have no row; the web page already got an\n// error reply for those.\nconst e = $('Error Trigger').first().json;\nconst exec = e.execution || {};\nconst err = exec.error || (e.trigger && e.trigger.error) || {};\n\nconst parts = [err.message || 'Unknown error'];\nif (err.description) parts.push(String(err.description));\nif (exec.lastNodeExecuted) parts.push(`(at node \"${exec.lastNodeExecuted}\")`);\nif (exec.url) parts.push(`Execution: ${exec.url}`);\nconst message = parts.join(' ').slice(0, 2000);\n\nreturn $input.all()\n  .map((i) => i.json)\n  .filter((r) => r.job_id && String(r.execution_id) === String(exec.id) && r.status === 'running')\n  .map((r) => ({ json: { job_id: r.job_id, status: 'failed', finished_at: new Date().toISOString(), message } }));\n"
      },
